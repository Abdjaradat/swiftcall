rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in user can read profiles
    match /users/{userId} {
      allow read: if request.auth != null;

      // Owner can write their own data
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      // Owner can update their own data, OR
      // Friends can update contacts/requests fields (check both old and new data)
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.keys().hasAll(['contacts']) && request.auth.uid in resource.data.contacts) ||
        (resource.data.keys().hasAll(['incomingRequests']) && request.auth.uid in resource.data.incomingRequests) ||
        (resource.data.keys().hasAll(['outgoingRequests']) && request.auth.uid in resource.data.outgoingRequests) ||
        // Allow if updating friend request fields
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts', 'incomingRequests', 'outgoingRequests', 'lastSeen']))
      );
    }

    // Chats: only participants can read or write
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;

      // Messages subcollection: same participant check
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId))
               .data.participantIds;
      }
    }

    // Calls: caller or receiver can read/update; only caller can create; nobody can delete
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId;

      allow update: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
    }

    // Group calls: any participant can read/write
    match /group_calls/{callId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantUids;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantUids;
    }

    // Token wallets: only owner can read/write
    match /token_wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
