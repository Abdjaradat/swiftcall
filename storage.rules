rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile images
    match /profile_images/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Chat images (10MB limit)
    match /chat_images/{chatId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Chat files (50MB limit)
    match /chat_files/{chatId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Chat audio (20MB limit)
    match /chat_audio/{chatId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Chat videos (100MB limit)
    match /chat_videos/{chatId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
